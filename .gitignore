/.claude
/.venv

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Numba JIT cache (cache=True writes .nbc/.nbi next to __pycache__)
*.nbc
*.nbi

# C extensions
*.so

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*

# Generated test/benchmark artifacts (everything the test scripts write)
/test_output/

# OS junk
.DS_Store
Thumbs.db

# Demo videos: renderers and their output (kept local)
/videos/
/video_output/
